{
  "name": "zxrsaa-webstore",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "npx wrangler d1 migrations apply zxrsa-db --local",
    "db:migrate:prod": "npx wrangler d1 migrations apply zxrsa-db --remote",
    "deploy": "nuxt build && npx wrangler pages deploy .output/public --project-name=zxrsa-webstore-db"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.8",
    "@pinia/nuxt": "^1.0.3",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.4",
    "html-to-image": "^1.11.13",
    "midtrans-client": "^1.4.3",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.32",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@types/node": "^26.6.5",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.151.1"
  }
}
